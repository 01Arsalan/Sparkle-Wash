{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },

    // explicit mapping for otp (guarantees /api/otp -> api/otp.js)
    { "src": "^/api/otp$", "dest": "/api/otp.js" },

    // general mapping for other api files (extensionless -> .js)
    { "src": "^/api/(.*)$", "dest": "/api/$1.js" },

    // SPA fallback
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
